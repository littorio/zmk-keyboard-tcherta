if BOARD_TCHERTA_LEFT || BOARD_TCHERTA_RIGHT

config CONFIG_ZMK_BATTERY_REPORTING
    default y

config ZMK_DISPLAY
    default y

if ZMK_DISPLAY

config SPI
    default y

# config IL0323
#    default y

config ZMK_DISPLAY_BLANK_ON_IDLE
    default y

# Needed for the IL0323 driver which allocs memory to clear the display
