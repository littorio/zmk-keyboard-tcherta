#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "zmk-helpers/helper.h"

// layers
#define DEFAULT 0
#define L_NAV 1
#define L_NUM 2
#define L_SYM 3
#define L_BOOT 4

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };
};


ZMK_COMBO(lpar_lt, &mp_lpar_lt, 32 33, DEFAULT)
ZMK_COMBO(rpar_gt, &mp_rpar_gt, 33 34, DEFAULT)
ZMK_COMBO(lbrc_lbkt, &mp_lbrc_lbkt, 45 46, DEFAULT)
ZMK_COMBO(rbrc_rbkt, &mp_rbrc_rbkt, 46 47, DEFAULT)

/ {

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <26 27>;
            bindings = <&kp TAB>;
        };
    };


    behaviors {

        // tap:     {
        // shift:   [
        mp_lbrc_lbkt: morph_lbrc_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LBRC>, <&kp LBKT>;
        };

        // tap:     }
        // shift:   ]
        mp_rbrc_rbkt: morph_rbrc_rbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RBRC>, <&kp RBKT>;
        };

        // tap:     ,
        // shift:   ;
        mp_key_cs: morph_key_comma_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp COMMA>, <&kp SEMICOLON>;
        };

        // tap:     (
        // shift:   <
        mp_lpar_lt: morph_lpar_lt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp LPAR>, <&kp LT>;
        };

        // tap:     )
        // shift:   >
        mp_rpar_gt: morph_rpar_gt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp RPAR>, <&kp GT>;
        };

        // tap:     .
        // shift:   :
        mp_key_dc: morph_key_dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            bindings = <&kp DOT>, <&kp COLON>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < 6 7 8 9 10 11 18 19 20 21 22 23 31 32 33 34 35 36 44 45 46 47 48 49 53 54 55>;
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = < 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 30 37 38 39 40 41 42 43 50 51 52>;
            hold-trigger-on-release;
        };
        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            quick-release;
            ignore-modifiers;
        };
        dsk: dual_sticky_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&skq>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------
// |  1  |  2  |  3  |  4  |  5  |  6  |                  |  7  |  8  |  9  |  0  | -  |  =  |
// |  Q  |  Q  |  W  |  E  |  R  |  T  |                  |  Y  |  U  |  I  |  O  | P  |  P  |
// |  Q  |  A  |  S  |  D  |  F  |  G  |  T  |            |  H  |  J  |  K  |  L  | ;  |  P  |
// |  Q  |  Z  |  X  |  C  |  V  |  B  |  T  |            |  N  |  M  |  ,  |  .  | /  |  P  |
// |  Q  |  Q  |  Q  |  A  |  A  |  A  |  A  |            |  B  |  B  |  B  |  B  | P  |  P  |
            // RAlt has long been used as magic by me. Hence to not konfuse Karabiner
            // and being able to use my new and old keyboards together, right half has LALT
            // (instead of the RALT)
            bindings = <
&kp N1          &kp N2 &kp N3 &kp N4 &kp N5 &kp N6                                      &kp N7 &kp N8  &kp N9    &kp N0  &kp N0   &kp N0
&kp TAB         &kp Q  &kp W  &kp E  &kp R  &kp T                                       &kp Y  &kp U   &kp I     &kp O   &kp P    &kp N0
&kp LCTRL       &hml LGUI A  &hml LALT S &hml LCTRL D  &hml LSHIFT F  &kp G  &kp T      &kp H  &hmr RSHIFT J   &hmr RCTRL K     &hmr LALT L   &hmr RGUI APOS   &kp PIPE
&bootloader     &kp Z  &kp X  &kp C   &kp V  &kp B  &kp T                               &kp N  &kp M   &mp_key_cs &mp_key_dc &kp FSLH &bootloader
                              &dsk LGUI LSHIFT &lt L_NAV SPACE &dsk LGUI LSHIFT                  &lt L_SYM RET &lt L_NUM BSPC &kp DEL
            >;
        };

        nav_layer {
            bindings = <
&kp N1    &kp N2     &kp N3     &kp N4      &kp N5       &kp N6              &kp N7     &kp N8      &kp N9      &kp N0     &kp N0     &kp N0
&kp TAB   &kp Q      &kp W      &kp E       &kp R        &kp T               &kp K_REDO &kp K_PASTE &kp K_COPY  &kp K_CUT  &kp K_UNDO &none
&kp LCTRL &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHIFT F &kp G &kp T         &kp LEFT   &kp DOWN    &kp UP      &kp RIGHT  &caps_word &none
&kp LSHFT &kp Z      &kp X      &kp C       &kp V        &kp B &kp T         &kp HOME   &kp PG_DN   &kp PG_UP   &kp END    &kp INS    &none
                                            &kp C        &none &none         &kp RET &kp BSPC &kp DEL
            >;
        };

        num_layer {
            bindings = <
&kp N1    &kp N2     &kp N3     &kp N4      &kp N5       &kp N6              &kp N7 &kp N8  &kp N9    &kp N0  &kp N0   &kp N0
&kp TAB   &kp LBKT   &kp N7     &kp N8      &kp N9       &kp RBKT            &kp Y  &kp U   &kp I    &kp O   &kp P    &kp N0
&kp LCTRL &kp LT     &kp N4     &kp N5      &kp N6       &kp EQUAL &kp T     &kp H  &kp J   &kp K    &kp L   &kp N0   &kp N0
&kp LSHFT &kp GRAVE  &kp N1     &kp N2      &kp N3       &kp BSLH &kp T      &kp N  &kp M   &kp COMMA &kp DOT &kp FSLH &kp N0
                                           &kp DOT      &kp N0    &kp MINUS  &kp RET &none &kp DEL
            >;
        };

        sym_layer {
            bindings = <
&kp N1    &kp N2     &kp N3     &kp N4      &kp N5       &kp N6              &kp N7 &kp N8  &kp N9    &kp N0  &kp N0   &kp N0
&kp TAB   &kp LBRC   &kp AMPS   &kp STAR    &kp LPAR     &kp RBRC            &kp Y  &kp U   &kp I     &kp O   &bootloader    &kp N0
&kp LCTRL &kp GT     &kp DLLR   &kp PERCENT &kp CARET    &kp PLUS  &kp T     &kp H  &kp J   &kp K     &kp L   &kp N0   &kp N0
&kp LSHFT &kp TILDE  &kp EXCL   &kp AT_SIGN &kp HASH     &kp PIPE  &kp T     &kp N  &kp M   &kp COMMA &kp DOT &kp FSLH &kp N0
                                            &kp LPAR     &kp RPAR  &kp UNDER &none &kp BSPC &kp DEL
            >;
        };

        // a stupid layer only for left left bootloader
        l_boot_layer {
            bindings = <
&bootloader    &kp N2     &kp N3     &kp N4      &kp N5       &kp N6              &kp N7 &kp N8  &kp N9    &kp N0  &kp N0   &bootloader
&kp TAB   &kp LS(Q)  &kp AMPS   &kp STAR    &kp LPAR     &kp RBRC            &kp LS(Y)  &kp U   &kp I     &kp O   &kp P    &kp N0
&kp LCTRL &kp COLON  &kp DLLR   &kp PERCENT &kp CARET    &kp PLUS  &kp T     &kp H  &kp J   &kp K     &kp L   &kp N0   &kp N0
&kp LSHFT &kp TILDE  &kp EXCL   &kp AT_SIGN &kp HASH     &kp PIPE  &kp T     &kp N  &kp M   &kp COMMA &kp DOT &kp FSLH &kp N0
                                            &kp LPAR     &kp RPAR  &kp UNDER &none &kp BSPC &kp DEL
            >;
        };

    };
};
