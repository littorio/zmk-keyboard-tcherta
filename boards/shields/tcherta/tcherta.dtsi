/* tcherta.dtsi */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <13>;
        rows = <5>;
        map = <
            /* 0-4, 10-14, 20-24, 30-32                     5-9, 15-19, 25-29. 33-35 */
            RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)         RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)         RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)         RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                            RC(4,4) RC(4,5) RC(4,6)         RC(4, 7) RC(4, 8) RC(4, 9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
    };
};
