/* plenka.dtsi */
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <15>;
        rows = <4>;
        map = <
            /* 1-4, 10-14, 20-24, 30-32 */                  /* 5-9, 15-19, 25-29, 33, 34 */
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)         RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)         RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)         RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14)
            /* Thumb block (Row 3, Cols 5-7) */
                            RC(3,7) RC(3,6) RC(3,5)         RC(3,12) RC(3,13)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
    };
};


